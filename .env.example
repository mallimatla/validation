CORS_ORIGIN=http://localhost:3000

# Security
AGENT_SIGNING_SECRET=your-signing-secret
AUDIT_SIGNING_SECRET=your-audit-signing-secret

# Feature Flags
SNAPSHOT_EXPIRY_DAYS=90
