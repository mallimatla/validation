# =============================================================================
# VALIDATION COUNCIL - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# For local development:
DATABASE_URL=postgresql://validation:validation_secret@localhost:5432/validation_council

# For production (use your cloud provider's connection string):
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# If using Docker Compose:
POSTGRES_USER=validation
POSTGRES_PASSWORD=validation_secret
POSTGRES_DB=validation_council
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# For local development:
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# For production (e.g., Railway, Upstash, Redis Cloud):
# REDIS_URL=redis://:password@host:port

# -----------------------------------------------------------------------------
# AI/LLM Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key (optional fallback) - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Authentication (Clerk) - Get from https://clerk.com
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Clerk webhook secret (for syncing user data)
CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay) - Get from https://dashboard.razorpay.com
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Plan IDs (create these in Razorpay dashboard)
RAZORPAY_STARTER_PLAN_ID=plan_starter_id
RAZORPAY_PROFESSIONAL_PLAN_ID=plan_professional_id
RAZORPAY_ENTERPRISE_PLAN_ID=plan_enterprise_id

# -----------------------------------------------------------------------------
# External Data Integrations (Optional but recommended)
# -----------------------------------------------------------------------------
# Crunchbase API - Get from https://www.crunchbase.com/partners/crunchbase-enterprise
CRUNCHBASE_API_KEY=

# LinkedIn Data via Proxycurl - Get from https://nubela.co/proxycurl
PROXYCURL_API_KEY=

# News API - Get from https://newsapi.org
NEWS_API_KEY=

# Google Trends (if available)
GOOGLE_TRENDS_API_KEY=

# -----------------------------------------------------------------------------
# Storage (AWS S3 for snapshots)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=validation-council-snapshots
S3_BUCKET=validation-council-evidence

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret for signing agent reports (generate a strong random string)
AGENT_SIGNING_SECRET=your-32-character-random-secret-key
AUDIT_SIGNING_SECRET=your-audit-signing-secret

# JWT Secret (if using custom auth instead of Clerk)
JWT_SECRET=your-jwt-secret-key

# -----------------------------------------------------------------------------
# Email (for notifications)
# -----------------------------------------------------------------------------
# SendGrid API Key - Get from https://sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@validationcouncil.com

# Or use Resend - Get from https://resend.com
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# -----------------------------------------------------------------------------
# Sentry for error tracking - Get from https://sentry.io
SENTRY_DSN=

# PostHog for analytics - Get from https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_DEMO_MODE=false
ENABLE_INVESTOR_FEATURES=false
ENABLE_REFUND_GUARANTEE=true
SNAPSHOT_EXPIRY_DAYS=90
