# Backend API URL
# Production: https://api.startupverdict.com
# Development: http://localhost:3001
NEXT_PUBLIC_API_URL=https://api.startupverdict.com

# App URL (for redirects and links)
NEXT_PUBLIC_APP_URL=https://startupverdict.com

# Clerk Authentication (get from clerk.com dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk URLs (Next.js routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
