    "@nestjs/swagger": "^7.3.0",
    "@nestjs/bull": "^10.1.0",
    "@nestjs/cache-manager": "^2.2.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@prisma/client": "^5.10.0",
    "@validation-council/shared": "*",
    "@validation-council/agent-core": "*",
    "bull": "^4.12.0",
    "cache-manager": "^5.4.0",
